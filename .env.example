# 공공데이터포털 (data.go.kr) → 국토교통부 아파트매매 실거래가 API
# "일반 인증키 (Decoding)" 값을 붙여넣으세요.
MOLIT_API_KEY=여기에_디코딩_키_붙여넣기

# 공공데이터포털 → 국토교통부 건축HUB 건축물대장정보 API
BUILDING_HUB_API_KEY=
# 공공데이터포털 → 공동주택 기본정보 API
APT_BASIC_API_KEY=
# 위 두 API에서 공통으로 사용할 수 있는 일반 인증키
DATA_GO_KR_API_KEY=
# 한 번의 자동 수집에서 보강할 단지 수 (기본 80, 최대 200)
APARTMENT_METADATA_BATCH_SIZE=80

PORT=3000
## Optional separate key approved for the apartment rent service.
MOLIT_RENT_API_KEY=

# Server-only credentials. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Keep the web process read-only. Run `npm run worker` for local collection.
INGEST_ENABLED=false
