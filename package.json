{
  "name": "seoul-estate-ai",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "publish:snapshot": "node scripts/publish-snapshot.mjs",
    "backfill:history": "node scripts/backfill-history.mjs --months=24",
    "dev": "concurrently -k \"node --watch server.js\" \"vite\" \"node --watch scripts/worker.mjs\"",
    "dev:web": "concurrently -k \"node --watch server.js\" \"vite\"",
    "worker": "node scripts/worker.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && NODE_ENV=production node server.js",
    "check": "vite build"
  },
  "dependencies": {
    "@seed-design/css": "^2.6.2",
    "@seed-design/react": "^2.4.1",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@seed-design/vite-plugin": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
